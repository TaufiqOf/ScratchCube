<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:ScratchCube.ViewModels.Pages"
             xmlns:docker="clr-namespace:ScratchCube.Models.Docker"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             x:DataType="pages:ContainerPageViewModel"
             x:Class="ScratchCube.Views.Controls.DataGrid.ContainerPageDataGridControlView">
    <UserControl.Styles>

        <!-- ====================================================== -->
        <!-- DATAGRID                                               -->
        <!-- ====================================================== -->

        <Style Selector="DataGrid">
            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="RowBackground"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal" />

            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent" />

            <Setter Property="HeadersVisibility"
                    Value="Column" />

            <Setter Property="RowHeight"
                    Value="58" />

            <Setter Property="CanUserResizeColumns"
                    Value="True" />

            <Setter Property="CanUserReorderColumns"
                    Value="True" />

            <Setter Property="IsReadOnly"
                    Value="True" />

            <Setter Property="SelectionMode"
                    Value="Single" />
        </Style>


        <!-- ====================================================== -->
        <!-- HEADER                                                  -->
        <!-- ====================================================== -->

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Height"
                    Value="44" />

            <Setter Property="Padding"
                    Value="12,0" />

            <Setter Property="FontSize"
                    Value="11" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <!-- Important -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <Setter Property="BorderThickness"
                    Value="0" />
        </Style>


        <!-- ====================================================== -->
        <!-- ROW                                                     -->
        <!-- ====================================================== -->

        <Style Selector="DataGridRow">
            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />

            <Setter Property="BorderThickness"
                    Value="0" />
        </Style>


        <!-- Row hover -->
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background"
                    Value="Transparent" />
        </Style>


        <!-- Row selected -->
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>


        <!-- Row selected template background -->
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="IsVisible"
                    Value="False" />
        </Style>


        <!-- Row hover template background -->
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="IsVisible"
                    Value="False" />
        </Style>


        <!-- ====================================================== -->
        <!-- CELLS                                                   -->
        <!-- ====================================================== -->

        <Style Selector="DataGridCell">
            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Padding"
                    Value="12,0" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="BorderBrush"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>
        
        <!-- Selected cell -->
        <Style Selector="DataGridCell:selected">
            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />

            <Setter Property="BorderBrush"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />
        </Style>


        <!-- Focused cell -->
        <Style Selector="DataGridCell:focus">
            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderBrush"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />
        </Style>


        <!-- ====================================================== -->
        <!-- BUTTONS                                                 -->
        <!-- ====================================================== -->

        <Style Selector="Button.iconButton">
            <Setter Property="Width"
                    Value="36" />

            <Setter Property="Height"
                    Value="36" />

            <Setter Property="Padding"
                    Value="0" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />
        </Style>


        <Style Selector="Button.imageButton">
            <Setter Property="Padding"
                    Value="0" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
        </Style>
    </UserControl.Styles>
    <DataGrid ItemsSource="{Binding FilteredContainers}"
              SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch"
              SelectionMode="Single"
              AutoGenerateColumns="False"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              IsReadOnly="True">

        <DataGrid.Styles>

            <!-- Remove the white focus rectangle around the current cell -->
            <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <!-- Remove the current-cell rectangle -->
            <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <!-- Also remove cell border -->
            <Style Selector="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Keep the row selection background -->
            <Style Selector="DataGridRow:selected">
                <Setter Property="Background"
                        Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
            </Style>

        </DataGrid.Styles>

        <DataGrid.Columns>

            <!-- ================================================== -->
            <!-- NAME                                                -->
            <!-- ================================================== -->

            <DataGridTemplateColumn Header="NAME"
                                    Width="230">

                <DataGridTemplateColumn.CellTemplate>

                    <DataTemplate x:DataType="docker:DockerContainer">

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">

                            <!-- Status indicator -->

                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{DynamicResource SystemControlSuccessBrush}"
                                     VerticalAlignment="Center" />


                            <StackPanel Spacing="2"
                                        VerticalAlignment="Center">

                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Status}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- ================================================== -->
            <!-- CONTAINER ID                                        -->
            <!-- ================================================== -->
            <DataGridTextColumn Header="CONTAINER ID"
                                Binding="{Binding Id}"
                                Width="*" />

            <!-- ================================================== -->
            <!-- IMAGE                                               -->
            <!-- ================================================== -->
            <DataGridTemplateColumn Header="IMAGE"
                                    Width="280">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="docker:DockerContainer">
                        <Button Classes="imageButton"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Image}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Button>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- ================================================== -->
            <!-- PORTS                                               -->
            <!-- ================================================== -->
            <DataGridTextColumn Header="PORT(S)"
                                Binding="{Binding DisplayPorts}"
                                Width="200" />


            <!-- ================================================== -->
            <!-- LAST STARTED                                        -->
            <!-- ================================================== -->
            <DataGridTemplateColumn Header="LAST STARTED"
                                    Width="160">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="docker:DockerContainer">
                        <TextBlock Text="{Binding Created, StringFormat='{}{0:g}'}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- ================================================== -->
            <!-- ACTIONS                                             -->
            <!-- ================================================== -->
            <DataGridTemplateColumn Header="ACTIONS"
                                    Width="130">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="docker:DockerContainer">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center">

                            <Button Classes="iconButton"
                                    Command="{Binding StartStopCommand}"
                                    ToolTip.Tip="{Binding StartStopTooltip}">
                                <fluent:FluentIcon Icon="{Binding StartStopIcon}"
                                                   Width="17"
                                                   Height="17" />
                            </Button>

                            <!-- MORE -->
                            <Button Classes="iconButton"
                                    ToolTip.Tip="More actions">
                                <fluent:FluentIcon Icon="MoreVertical"
                                                   Width="17"
                                                   Height="17" />
                            </Button>

                            <!-- DELETE -->

                            <Button Classes="iconButton"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip.Tip="Delete">
                                <fluent:FluentIcon Icon="Delete"
                                                   Width="17"
                                                   Height="17" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>