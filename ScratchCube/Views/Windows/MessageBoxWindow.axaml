<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScratchCube.Views.Windows.MessageBoxWindow"
        Title="Notification" MinWidth="500" MinHeight="300"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" 
        CanMinimize="False"
        CanMaximize="False"
        CanResize="False">
    <Grid RowDefinitions="*, Auto" Margin="16">
        <!-- Message Content -->
        <ScrollViewer Grid.Row="0">
            <ContentControl x:Name="ContentControl"></ContentControl>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="OK" Click="OnOkClicked"  Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>