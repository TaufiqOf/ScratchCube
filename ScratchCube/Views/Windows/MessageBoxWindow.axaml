<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScratchCube.Views.Windows.MessageBoxWindow"
        Title="Notification" Width="500" Height="300"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <Grid RowDefinitions="*, Auto" Margin="16">
        <!-- Message Content -->
        <ScrollViewer Grid.Row="0">
            <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" />
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="OK" Click="OnOkClicked" IsDefault="True" Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>