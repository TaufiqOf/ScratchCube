<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:component="clr-namespace:ScratchDocker.ViewModels.Controls"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             x:DataType="component:MenuControlViewModel"
             x:Class="ScratchDocker.Views.Controls.MenuControlView">
    <ListBox ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMenuItem}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*">
                    <fluent:FluentIcon Icon="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>

    </ListBox>

</UserControl>